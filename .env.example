# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# OpenDevin service URL (default: internal docker network)
OPENDEVIN_URL=http://opendevin:3000

# OpenDevin sandbox user
SANDBOX_USER_ID=1000

# LLM settings passed to OpenDevin (user can override via UI)
LLM_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS — comma-separated allowed origins (leave blank = allow all, dev only)
# CORS_ORIGINS=https://buildra.netlify.app,https://yourdomain.com
